import {
  "mizchi/converge_audit/audit" @checkpoint_audit,
  "mizchi/converge_audit/audit/commitment",
  "mizchi/converge_audit/audit/runtime" @audit_runtime,
  "moonbitlang/core/json",
}

supported_targets = "+js+wasm+wasm-gc"

options(
  link: {
    "js": {
      "exports": [
        "audit_classify_checkpoint_head",
        "audit_player_local_checkpoint_prunable",
        "audit_player_local_evidence_hold_admission_allowed",
        "audit_player_local_evidence_hold_resolution_allowed",
        "audit_player_local_evidence_inbox_advance_allowed",
        "audit_player_local_evidence_inbox_page_allowed",
        "audit_player_local_evidence_poll_claim_allowed",
        "audit_player_local_evidence_poll_lease_expiry",
        "audit_player_local_evidence_poll_next_retry_at",
        "audit_open_checkpoint_closure",
        "audit_prepare_atomic_checkpoint_seal",
        "audit_acknowledge_checkpoint_outbox",
        "audit_select_peer_delivery_batch",
        "audit_record_peer_delivery_failure",
        "audit_record_peer_delivery_success",
        "audit_select_peer_checkpoint_response",
      ],
    },
    "wasm-gc": {
      "exports": [
        "audit_classify_checkpoint_head",
        "audit_player_local_checkpoint_prunable",
        "audit_player_local_evidence_hold_admission_allowed",
        "audit_player_local_evidence_hold_resolution_allowed",
        "audit_player_local_evidence_inbox_advance_allowed",
        "audit_player_local_evidence_inbox_page_allowed",
        "audit_player_local_evidence_poll_claim_allowed",
        "audit_player_local_evidence_poll_lease_expiry",
        "audit_player_local_evidence_poll_next_retry_at",
        "audit_open_checkpoint_closure",
        "audit_prepare_atomic_checkpoint_seal",
        "audit_acknowledge_checkpoint_outbox",
        "audit_select_peer_delivery_batch",
        "audit_record_peer_delivery_failure",
        "audit_record_peer_delivery_success",
        "audit_select_peer_checkpoint_response",
      ],
      "use-js-builtin-string": true,
    },
  },
)
