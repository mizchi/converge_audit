///|
predicate evidence_lineage_case_admission_post(
  active_hold : Bool,
  boundary_matches : Bool,
  checkpoint_matches : Bool,
  reference_matches : Bool,
  ancestor_matches : Bool,
  authentication_succeeded : Bool,
  result : Bool,
) {
  if active_hold {
    if boundary_matches {
      if checkpoint_matches {
        if reference_matches {
          if ancestor_matches {
            result == authentication_succeeded
          } else {
            result == false
          }
        } else {
          result == false
        }
      } else {
        result == false
      }
    } else {
      result == false
    }
  } else {
    result == false
  }
}

///|
pub lemma accepted_evidence_lineage_case_requires_every_guard(
  active_hold : Bool,
  boundary_matches : Bool,
  checkpoint_matches : Bool,
  reference_matches : Bool,
  ancestor_matches : Bool,
  authentication_succeeded : Bool,
) where {
  proof_require: evidence_lineage_case_admission_post(
    active_hold,
    boundary_matches,
    checkpoint_matches,
    reference_matches,
    ancestor_matches,
    authentication_succeeded,
    true,
  ),
  proof_ensure: active_hold == true,
  proof_ensure: boundary_matches == true,
  proof_ensure: checkpoint_matches == true,
  proof_ensure: reference_matches == true,
  proof_ensure: ancestor_matches == true,
  proof_ensure: authentication_succeeded == true,
} {
}

