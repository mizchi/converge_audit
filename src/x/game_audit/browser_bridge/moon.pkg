import {
  "mizchi/converge_audit" @bft,
  "mizchi/converge_audit/audit/merkle",
  "mizchi/converge_audit/audit/authmap",
  "mizchi/converge_audit/x/game_audit/crypto",
  "mizchi/converge_audit/x/game_audit/inventory_origin",
  "mizchi/converge_audit/x/game_audit/inventory_record",
  "mizchi/converge_audit/x/game_audit/inventory_transition",
  "mizchi/converge_audit/x/game_audit/witness_manifest",
}

supported_targets = "+js+wasm+wasm-gc"

options(
  link: {
    "js": {
      "exports": [
        "audit_browser_sha256",
        "audit_browser_merkle_root",
        "audit_browser_merkle_leaf_payload",
        "audit_browser_merkle_node_payload",
        "audit_browser_merkle_empty_payload",
        "audit_browser_merkle_root_payload",
        "audit_browser_ed25519_public_key",
        "audit_browser_ed25519_sign",
        "audit_browser_ed25519_verify",
        "audit_browser_replay_witness_session_manifest_statement",
        "audit_browser_inventory_origin_receipt_statement",
        "audit_browser_inventory_origin_lineage_statement",
        "audit_browser_inventory_lineage_transition_statement",
        "audit_browser_inventory_record_statement",
        "audit_browser_authmap_empty_statement",
        "audit_browser_authmap_node_statement",
        "audit_browser_authmap_root_statement",
      ],
    },
  },
)
