///|
test "listing requires a clean authenticated asset lineage" {
  assert_true(
    asset_lineage_use_allowed(
      creation_verified=true,
      current_head_verified=true,
      open_revocations=0,
    ),
  )
  assert_false(
    asset_lineage_use_allowed(
      creation_verified=true,
      current_head_verified=true,
      open_revocations=1,
    ),
  )
  assert_false(
    asset_lineage_use_allowed(
      creation_verified=false,
      current_head_verified=true,
      open_revocations=0,
    ),
  )
  assert_false(
    asset_lineage_use_allowed(
      creation_verified=true,
      current_head_verified=false,
      open_revocations=0,
    ),
  )
}

///|
test "lineage decisions require an exact monotonic ancestor head" {
  assert_true(
    asset_lineage_decision_allowed(
      asset_exists=true,
      ancestor_in_lineage=true,
      expected_decision_matches=true,
      revision_advances=true,
      decision_changes_status=true,
    ),
  )
  assert_false(
    asset_lineage_decision_allowed(
      asset_exists=true,
      ancestor_in_lineage=false,
      expected_decision_matches=true,
      revision_advances=true,
      decision_changes_status=true,
    ),
  )
  assert_false(
    asset_lineage_decision_allowed(
      asset_exists=true,
      ancestor_in_lineage=true,
      expected_decision_matches=false,
      revision_advances=true,
      decision_changes_status=true,
    ),
  )
  assert_false(
    asset_lineage_decision_allowed(
      asset_exists=true,
      ancestor_in_lineage=true,
      expected_decision_matches=true,
      revision_advances=false,
      decision_changes_status=true,
    ),
  )
  assert_false(
    asset_lineage_decision_allowed(
      asset_exists=true,
      ancestor_in_lineage=true,
      expected_decision_matches=true,
      revision_advances=true,
      decision_changes_status=false,
    ),
  )
}

///|
test "external lineage certificates require authentication time and appeal binding" {
  assert_true(
    asset_lineage_certificate_allowed(
      certificate_authenticated=true,
      arbiter_known=true,
      lineage_bound=true,
      certificate_time_valid=true,
      lifecycle_valid=true,
      is_appeal=false,
      appeal_target_matches=false,
      appeal_window_open=false,
    ),
  )
  assert_false(
    asset_lineage_certificate_allowed(
      certificate_authenticated=false,
      arbiter_known=true,
      lineage_bound=true,
      certificate_time_valid=true,
      lifecycle_valid=true,
      is_appeal=false,
      appeal_target_matches=true,
      appeal_window_open=true,
    ),
  )
  assert_false(
    asset_lineage_certificate_allowed(
      certificate_authenticated=true,
      arbiter_known=true,
      lineage_bound=true,
      certificate_time_valid=false,
      lifecycle_valid=true,
      is_appeal=false,
      appeal_target_matches=true,
      appeal_window_open=true,
    ),
  )
  assert_true(
    asset_lineage_certificate_allowed(
      certificate_authenticated=true,
      arbiter_known=true,
      lineage_bound=true,
      certificate_time_valid=true,
      lifecycle_valid=true,
      is_appeal=true,
      appeal_target_matches=true,
      appeal_window_open=true,
    ),
  )
  assert_false(
    asset_lineage_certificate_allowed(
      certificate_authenticated=true,
      arbiter_known=true,
      lineage_bound=true,
      certificate_time_valid=true,
      lifecycle_valid=true,
      is_appeal=true,
      appeal_target_matches=false,
      appeal_window_open=true,
    ),
  )
  assert_false(
    asset_lineage_certificate_allowed(
      certificate_authenticated=true,
      arbiter_known=true,
      lineage_bound=true,
      certificate_time_valid=true,
      lifecycle_valid=true,
      is_appeal=true,
      appeal_target_matches=true,
      appeal_window_open=false,
    ),
  )
}

///|
test "bounded lineage admission requires every retention and authentication boundary" {
  for mask in 0..<128 {
    let has_transfers = (mask & 1) != 0
    let within_limit = (mask & 2) != 0
    let origin_matches = (mask & 4) != 0
    let anchor_matches = (mask & 8) != 0
    let parent_chain_matches = (mask & 16) != 0
    let every_transfer_authenticated = (mask & 32) != 0
    let current_record_matches = (mask & 64) != 0
    assert_eq(
      asset_lineage_slice_allowed(
        has_transfers~,
        within_limit~,
        origin_matches~,
        anchor_matches~,
        parent_chain_matches~,
        every_transfer_authenticated~,
        current_record_matches~,
      ),
      mask == 127,
    )
  }
}
