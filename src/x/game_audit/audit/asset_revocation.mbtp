///|
predicate asset_lineage_use_allowed_post(
  creation_verified : Bool,
  current_head_verified : Bool,
  open_revocations : Int,
  result : Bool,
) {
  if creation_verified {
    if current_head_verified {
      result == (open_revocations == 0)
    } else {
      result == false
    }
  } else {
    result == false
  }
}

///|
predicate asset_lineage_decision_allowed_post(
  asset_exists : Bool,
  ancestor_in_lineage : Bool,
  expected_decision_matches : Bool,
  revision_advances : Bool,
  decision_changes_status : Bool,
  result : Bool,
) {
  if asset_exists {
    if ancestor_in_lineage {
      if expected_decision_matches {
        if revision_advances {
          result == decision_changes_status
        } else {
          result == false
        }
      } else {
        result == false
      }
    } else {
      result == false
    }
  } else {
    result == false
  }
}

///|
predicate asset_lineage_certificate_allowed_post(
  certificate_authenticated : Bool,
  arbiter_known : Bool,
  lineage_bound : Bool,
  certificate_time_valid : Bool,
  lifecycle_valid : Bool,
  is_appeal : Bool,
  appeal_target_matches : Bool,
  appeal_window_open : Bool,
  result : Bool,
) {
  if certificate_authenticated {
    if arbiter_known {
      if lineage_bound {
        if certificate_time_valid {
          if lifecycle_valid {
            if is_appeal {
              if appeal_target_matches {
                result == appeal_window_open
              } else {
                result == false
              }
            } else {
              result == true
            }
          } else {
            result == false
          }
        } else {
          result == false
        }
      } else {
        result == false
      }
    } else {
      result == false
    }
  } else {
    result == false
  }
}

///|
predicate asset_lineage_slice_allowed_post(
  has_transfers : Bool,
  within_limit : Bool,
  origin_matches : Bool,
  anchor_matches : Bool,
  parent_chain_matches : Bool,
  every_transfer_authenticated : Bool,
  current_record_matches : Bool,
  result : Bool,
) {
  if has_transfers {
    if within_limit {
      if origin_matches {
        if anchor_matches {
          if parent_chain_matches {
            if every_transfer_authenticated {
              result == current_record_matches
            } else {
              result == false
            }
          } else {
            result == false
          }
        } else {
          result == false
        }
      } else {
        result == false
      }
    } else {
      result == false
    }
  } else {
    result == false
  }
}

///|
pub lemma accepted_asset_use_has_no_open_revocation(
  creation_verified : Bool,
  current_head_verified : Bool,
  open_revocations : Int,
) where {
  proof_require: asset_lineage_use_allowed_post(
    creation_verified,
    current_head_verified,
    open_revocations,
    true,
  ),
  proof_ensure: creation_verified == true,
  proof_ensure: current_head_verified == true,
  proof_ensure: open_revocations == 0,
} {
}

///|
pub lemma open_revocation_rejects_asset_use(
  creation_verified : Bool,
  current_head_verified : Bool,
  open_revocations : Int,
  allowed : Bool,
) where {
  proof_require: asset_lineage_use_allowed_post(
    creation_verified,
    current_head_verified,
    open_revocations,
    allowed,
  ),
  proof_require: open_revocations > 0,
  proof_ensure: allowed == false,
} {
}

///|
pub lemma accepted_lineage_decision_has_exact_ancestor_head(
  asset_exists : Bool,
  ancestor_in_lineage : Bool,
  expected_decision_matches : Bool,
  revision_advances : Bool,
  decision_changes_status : Bool,
) where {
  proof_require: asset_lineage_decision_allowed_post(
    asset_exists,
    ancestor_in_lineage,
    expected_decision_matches,
    revision_advances,
    decision_changes_status,
    true,
  ),
  proof_ensure: asset_exists == true,
  proof_ensure: ancestor_in_lineage == true,
  proof_ensure: expected_decision_matches == true,
  proof_ensure: revision_advances == true,
  proof_ensure: decision_changes_status == true,
} {
}

///|
pub lemma accepted_lineage_certificate_has_every_trust_boundary(
  certificate_authenticated : Bool,
  arbiter_known : Bool,
  lineage_bound : Bool,
  certificate_time_valid : Bool,
  lifecycle_valid : Bool,
  is_appeal : Bool,
  appeal_target_matches : Bool,
  appeal_window_open : Bool,
) where {
  proof_require: asset_lineage_certificate_allowed_post(
    certificate_authenticated,
    arbiter_known,
    lineage_bound,
    certificate_time_valid,
    lifecycle_valid,
    is_appeal,
    appeal_target_matches,
    appeal_window_open,
    true,
  ),
  proof_ensure: certificate_authenticated == true,
  proof_ensure: arbiter_known == true,
  proof_ensure: lineage_bound == true,
  proof_ensure: certificate_time_valid == true,
  proof_ensure: lifecycle_valid == true,
} {
}

///|
pub lemma accepted_lineage_appeal_has_exact_open_window(
  certificate_authenticated : Bool,
  arbiter_known : Bool,
  lineage_bound : Bool,
  certificate_time_valid : Bool,
  lifecycle_valid : Bool,
  appeal_target_matches : Bool,
  appeal_window_open : Bool,
) where {
  proof_require: asset_lineage_certificate_allowed_post(
    certificate_authenticated,
    arbiter_known,
    lineage_bound,
    certificate_time_valid,
    lifecycle_valid,
    true,
    appeal_target_matches,
    appeal_window_open,
    true,
  ),
  proof_ensure: appeal_target_matches == true,
  proof_ensure: appeal_window_open == true,
} {
}

///|
pub lemma expired_lineage_certificate_is_rejected(
  certificate_authenticated : Bool,
  arbiter_known : Bool,
  lineage_bound : Bool,
  lifecycle_valid : Bool,
  is_appeal : Bool,
  appeal_target_matches : Bool,
  appeal_window_open : Bool,
  allowed : Bool,
) where {
  proof_require: asset_lineage_certificate_allowed_post(
    certificate_authenticated,
    arbiter_known,
    lineage_bound,
    false,
    lifecycle_valid,
    is_appeal,
    appeal_target_matches,
    appeal_window_open,
    allowed,
  ),
  proof_ensure: allowed == false,
} {
}

///|
pub lemma accepted_lineage_slice_has_every_boundary(
  has_transfers : Bool,
  within_limit : Bool,
  origin_matches : Bool,
  anchor_matches : Bool,
  parent_chain_matches : Bool,
  every_transfer_authenticated : Bool,
  current_record_matches : Bool,
) where {
  proof_require: asset_lineage_slice_allowed_post(
    has_transfers,
    within_limit,
    origin_matches,
    anchor_matches,
    parent_chain_matches,
    every_transfer_authenticated,
    current_record_matches,
    true,
  ),
  proof_ensure: has_transfers == true,
  proof_ensure: within_limit == true,
  proof_ensure: origin_matches == true,
  proof_ensure: anchor_matches == true,
  proof_ensure: parent_chain_matches == true,
  proof_ensure: every_transfer_authenticated == true,
  proof_ensure: current_record_matches == true,
} {
}

///|
pub lemma unauthenticated_lineage_slice_is_rejected(
  has_transfers : Bool,
  within_limit : Bool,
  origin_matches : Bool,
  anchor_matches : Bool,
  parent_chain_matches : Bool,
  current_record_matches : Bool,
  allowed : Bool,
) where {
  proof_require: asset_lineage_slice_allowed_post(
    has_transfers,
    within_limit,
    origin_matches,
    anchor_matches,
    parent_chain_matches,
    false,
    current_record_matches,
    allowed,
  ),
  proof_ensure: allowed == false,
} {
}
