import {
  "mizchi/converge_audit/prdt",
  "mizchi/converge_audit/prdt/mmo",
  "moonbitlang/core/json",
}

supported_targets = "+js+wasm+wasm-gc"

options(
  link: {
    "js": {
      "exports": [
        "prdt_mmo_propose",
        "prdt_mmo_merge",
        "prdt_mmo_close",
        "prdt_mmo_decision",
        "prdt_mmo_delta",
        "prdt_mmo_world",
      ],
    },
    "wasm-gc": {
      "exports": [
        "prdt_mmo_propose",
        "prdt_mmo_merge",
        "prdt_mmo_close",
        "prdt_mmo_decision",
        "prdt_mmo_delta",
        "prdt_mmo_world",
      ],
      "use-js-builtin-string": true,
    },
  },
)
