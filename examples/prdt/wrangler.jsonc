{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "converge-prdt-room",
  "main": "src/runtime/cloudflare/worker.ts",
  "compatibility_date": "2026-08-04",
  "durable_objects": {
    "bindings": [
      { "name": "PRDT_ROOM", "class_name": "PrdtRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PrdtRoom"] }
  ],
  "vars": {
    "AUTHORITY_SECRET": "dev-only-secret"
  }
}
